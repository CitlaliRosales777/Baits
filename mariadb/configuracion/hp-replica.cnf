# HP Ubuntu: réplica ligera. Cargar desde /etc/mysql/mariadb.conf.d/60-moodsitto-replica.cnf
[mariadb]
bind-address=127.0.0.1,100.112.196.81
port=3306
server_id=2

log_bin=mariadb-bin
relay_log=mariadb-relay-bin
binlog_format=ROW
gtid_strict_mode=ON
log_slave_updates=ON
read_only=ON
expire_logs_days=7

innodb_buffer_pool_size=128M
max_connections=15
tmp_table_size=8M
max_heap_table_size=8M
thread_cache_size=4
table_open_cache=256
skip_name_resolve=ON
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
